# ==============================================================================
# MusicMotion - Environment Configuration Template
# NOTE: Never commit production credentials. Copy this file to .env or .env.local
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://musicmotion:musicmotion_secret@localhost:5432/musicmotion?schema=public"

# Redis Connection (BullMQ Queue & Caching)
REDIS_URL="redis://localhost:6379"

# Music Provider APIs (Jamendo & Free/Licensed APIs)
# Get credentials at: https://developer.jamendo.com
JAMENDO_CLIENT_ID="your_jamendo_client_id_here"
JAMENDO_CLIENT_SECRET="your_jamendo_client_secret_here"

# Freesound API (Optional sound effect provider)
FREESOUND_API_KEY="your_freesound_api_key_here"

# AI Visual Scene Generation (OpenAI / DALL-E / Stability / Replicate)
OPENAI_API_KEY="your_openai_api_key_here"

# Remotion Video Rendering & Cloud Storage (S3 / Local)
REMOTION_SERVE_URL="http://localhost:3000"
STORAGE_PROVIDER="local" # "local" | "s3"
STORAGE_BUCKET="musicmotion-assets"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
S3_ENDPOINT="" # Optional custom S3 / MinIO endpoint

# Worker & Rendering Queue
WORKER_CONCURRENCY=2
MAX_VIDEO_DURATION_SECONDS=60
VIDEO_DEFAULT_FPS=30
VIDEO_DEFAULT_WIDTH=1080
VIDEO_DEFAULT_HEIGHT=1920
